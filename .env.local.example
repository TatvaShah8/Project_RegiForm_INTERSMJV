# Copy to .env.local in the project root. Never commit the filled-in file.
# Firebase Console > Project settings > Your apps > Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional Firebase web config values (not used for image uploads)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Firebase Console > Project settings > Service accounts > Generate new private key
# Choose ONE server credential option. Prefer the absolute JSON file path on Windows:
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/firebase-service-account.json
# Or a single-line JSON object wrapped in single quotes; keep JSON \n escapes in private_key:
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"YOUR_PROJECT_ID","client_email":"YOUR_CLIENT_EMAIL","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"}'
FIREBASE_SERVICE_ACCOUNT_JSON=
# Firebase Authentication user UIDs authorized to manage tickets and verification (comma-separated)
ADMIN_FIREBASE_UIDS=

# Atlas connection string; URL-encode username/password special characters.
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_URL_ENCODED_PASSWORD@YOUR_CLUSTER_HOST/?retryWrites=true&w=majority
MONGODB_DB=

# Supabase Project Settings > API: server secret key (or legacy service_role key)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Existing Storage bucket name; public/private is detected without changing its access.
SUPABASE_BUCKET=

# Only needed for the repository's legacy, unused Prisma/SQLite tooling.
DATABASE_URL=file:../db/custom.db
